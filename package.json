{
  "name": "sweafex-platform",
  "version": "1.0.0",
  "description": "SweafEx Operations & Logistics Management Platform",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "db:migrate": "npm --workspace=backend run db:migrate",
    "db:seed": "npm --workspace=backend run db:seed",
    "db:clean-prod": "npm --workspace=backend run db:clean-prod",
    "db:studio": "npm --workspace=backend run db:studio"
  },
  "keywords": [
    "logistics",
    "freight-management",
    "sweafex"
  ],
  "author": "Octagram AI & Software Solutions",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
